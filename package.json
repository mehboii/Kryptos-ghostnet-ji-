{
  "name": "ghostnet",
  "version": "1.0.0",
  "description": "GhostNet — Decentralized Mesh Network Infrastructure",
  "type": "module",
  "scripts": {
    "start": "node ghostnet-server.js",
    "start:cloud": "node ghostnet-orchestrator.cjs --mode=cloud",
    "start:local": "node ghostnet-orchestrator.cjs --mode=local",
    "start:dev": "node ghostnet-orchestrator.cjs --mode=development",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 list",
    "health": "node ghostnet-orchestrator.cjs --health",
    "status": "node ghostnet-orchestrator.cjs --status",
    "stop": "node ghostnet-orchestrator.cjs --stop",
    "watch": "node ghostnet-watchdog.cjs",
    "check": "node ghostnet-watchdog.cjs --once",
    "server": "node ghostnet-server.js",
    "bridge": "node ghostnet-bridge/bridge.js",
    "client": "node ghostnet-client/server.js",
    "build": "echo 'static site'",
    "stress-test": "node stress-test-ws.js",
    "stress-test:chaos": "node stress-test-ws.js --chaos",
    "stress-test:100": "node stress-test-ws.js --clients=100 --duration=120",
    "stress-test:logout": "node stress-test-logout.js",
    "stress-test:logout-heavy": "node stress-test-logout.js --users=100 --cycles=20"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "acorn": "^8.16.0",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "cacache": "^20.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ethers": "^5.8.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "qrcodejs": "^1.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@abandonware/bleno": "^0.6.2",
    "@abandonware/noble": "^1.9.2-26",
    "@capacitor/android": "^8.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.0"
  }
}
