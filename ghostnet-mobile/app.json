{
  "expo": {
    "name": "GhostNet",
    "slug": "ghostnet-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ghostnet-logo.png",
    "scheme": "ghostnet",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.n11x.ghostnet"
    },
    "android": {
      "package": "dev.n11x.ghostnet",
      "adaptiveIcon": {
        "backgroundColor": "#0a0e27",
        "foregroundImage": "./assets/images/ghostnet-logo.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ghostnet-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ghostnet-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0e27",
          "dark": {
            "image": "./assets/images/ghostnet-logo.png",
            "backgroundColor": "#0a0e27"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
