{
  "name": "kryptos",
  "version": "1.0.0",
  "description": "Kryptos — Decentralized Mesh Network Infrastructure",
  "type": "module",
  "scripts": {
    "start": "node kryptos-server.js",
    "start:cloud": "node kryptos-orchestrator.cjs --mode=cloud",
    "start:local": "node kryptos-orchestrator.cjs --mode=local",
    "start:dev": "node kryptos-orchestrator.cjs --mode=development",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 list",
    "health": "node kryptos-orchestrator.cjs --health",
    "status": "node kryptos-orchestrator.cjs --status",
    "stop": "node kryptos-orchestrator.cjs --stop",
    "watch": "node kryptos-watchdog.cjs",
    "check": "node kryptos-watchdog.cjs --once",
    "server": "node kryptos-server.js",
    "bridge": "node kryptos-bridge/bridge.js",
    "client": "node kryptos-client/server.js"
  },
  "dependencies": {
    "@abandonware/bleno": "latest",
    "@abandonware/noble": "^1.9.2-26",
    "acorn": "^8.16.0",
    "bcrypt": "^6.0.0",
    "cacache": "^20.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ethers": "^5.8.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "qrcodejs": "^1.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
