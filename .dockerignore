# ============================================
# Kryptos — Docker Ignore
# ============================================

# Dependencies (rebuilt inside container)
node_modules
*/node_modules
**/node_modules

# Environment files (injected via docker-compose)
.env
.env.*
!.env.example

# Git
.git
.gitignore

# IDE
.vscode
.idea
.agent
.agents

# Runtime data (volumes handle persistence)
*.sqlite
logs/
*.log

# OS files
Thumbs.db
.DS_Store

# Build artifacts
dist/
build/

# Docker files (no need to copy themselves)
Dockerfile*
docker-compose*.yml
.dockerignore

# Docs
*.md
!README.md

# Test files
test*.js
simulation.js

# PM2 (replaced by Docker)
ecosystem.config.cjs
kryptos-orchestrator.cjs
kryptos-watchdog.cjs
