# GhostNet — environment variable template (NO real secrets here).
# Copy to .env and fill in real values. .env is gitignored; .env.example is not.
#
# This file documents the variables introduced for Cloudflare Realtime TURN.
# Other server variables (e.g. AUTH_JWT_SECRET, DATABASE_URL, PORT) are also
# required by ghostnet-server.js but are intentionally not duplicated here.

# ── Cloudflare Realtime TURN ──────────────────────────────────────────────────
# Used ONLY server-side by POST /turn/credentials to mint short-lived TURN
# credentials. These secrets MUST NOT be exposed to the client or committed.
# Create at: Cloudflare dashboard → Calls → TURN.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
