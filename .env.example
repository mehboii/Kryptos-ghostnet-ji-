# ============================================
# GhostNet Auth — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to source control.
# ============================================

# REQUIRED in production — a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_JWT_SECRET=change-me

# Optional — token lifetime (default: 24h)
# AUTH_JWT_EXPIRES_IN=24h

# --- PIN Auth (Argon2id) ---
# REQUIRED in production — a 256-bit hex secret used as HMAC pepper.
# NEVER store this in the database alongside hashes.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_AUTH_PEPPER=change-me-generate-a-real-pepper

# Optional — Argon2id tuning (defaults shown)
# ARGON2_MEMORY_COST_KIB=65536    # 64 MiB (set to 262144 for 256 MiB on beefy servers)
# ARGON2_TIME_COST=3               # Iterations
# ARGON2_PARALLELISM=2             # Parallel lanes (1-4)

# --- Docker Port Overrides ---
# Override host-side port mapping when running via docker compose
# GHOSTNET_SERVER_PORT=8080
# GHOSTNET_BRIDGE_PORT=3001
# GHOSTNET_CLIENT_PORT=3000
# GHOSTNET_MESSAGES_PORT=8090
# GHOSTNET_RELAY_1_PORT=8081
# GHOSTNET_RELAY_2_PORT=8082
# GHOSTNET_RELAY_3_PORT=8083
# GHOSTNET_REGISTRY_PORT=9000
# GHOSTNET_CHAIN_PORT=4000
# GHOSTNET_VAULT_PORT=4001

# --- Blockchain Abstraction Layer ---
# Provider type: evm | polygon | hardhat | custom-evm
# GHOSTNET_CHAIN_PROVIDER=evm
# ETH_RPC_URL=http://127.0.0.1:8545
# NEVER commit private keys — use environment variables only.
ETH_PRIVATE_KEY=your_ethereum_private_key_here

# --- Vault Service ---
# GHOSTNET_CHAIN_URL=http://127.0.0.1:4000
# GHOSTNET_VAULT_URL=http://127.0.0.1:4001
