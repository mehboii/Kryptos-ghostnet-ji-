# ============================================
# GhostNet — Master Environment Configuration
# ============================================
# NEVER commit this file to source control.
# ============================================

# --- Runtime Mode ---
# Options: cloud | local | development
GHOSTNET_MODE=development

# --- Server ---
GHOSTNET_SERVER_PORT=8080
GHOSTNET_SERVER_HOST=0.0.0.0

# --- Bridge ---
GHOSTNET_BRIDGE_PORT=3001
GHOSTNET_BRIDGE_HOST=0.0.0.0
GHOSTNET_BRIDGE_URL=https://ghostnet-ji-production.up.railway.app

# --- Client ---
GHOSTNET_CLIENT_PORT=3000
GHOSTNET_CLIENT_HOST=0.0.0.0

# --- Auth ---
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_EXPIRES_IN=24h

# --- SMTP (Email Verification / 2FA) ---
# Leave blank to use Ethereal (dev test SMTP — preview link in server logs)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use App Password
# For SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GhostNet" <noreply@ghostnet.io>

# --- Blockchain ---
ETH_RPC_URL=http://127.0.0.1:8545
ETH_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BTC_RPC_USER=admin
BTC_RPC_PASS=123
BTC_RPC_PORT=18443
SOL_ADDRESS=HN7cABqLq46Es1jh92dQQisAq662SmxELLLsHHe4YWrH

# --- Mesh ---
MESH_MAX_PEERS=50
MESH_HEARTBEAT_INTERVAL=30000
MESH_STALE_TIMEOUT=90000

# --- Logging ---
LOG_LEVEL=debug
LOG_TIMESTAMP=true
